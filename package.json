{
  "name": "supervive-revive-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local/LAN backend and match server for your own copy of SUPERVIVE 2.0.4. No game files included.",
  "type": "module",
  "scripts": {
    "start": "bun server/main.ts",
    "setup": "bun tools/setup.ts",
