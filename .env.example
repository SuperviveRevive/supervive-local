# SUPERVIVE Revive — Local Edition configuration. Copy to `.env` and edit.

# Where the backend listens. 127.0.0.1 = this PC only (solo / you host and play on the same PC).
# For LAN play set REVIVE_LAN=1 and REVIVE_BIND to this PC's LAN address (or 0.0.0.0 for all interfaces).
REVIVE_BIND=127.0.0.1
REVIVE_PORT=24970
REVIVE_LAN=0

# Address friends' PCs use to reach this PC (the match host). Leave empty to auto-detect the first
# private IPv4 address. Only used in LAN mode.
REVIVE_PUBLIC_HOST=

# UDP port the host's match server listens on.
REVIVE_MATCH_PORT=7777

# State directory (profiles, tokens, signing key, generated data). Never commit it.
REVIVE_DATA_DIR=./local-data

# Fill empty match slots with bots after this many seconds in queue (0 = never).
REVIVE_BOT_FILL_SECONDS=20

# Hand matches to a match server running on a host PC (`bun run match`, see docs/MATCHES.md).
# 0 = matchmaking and Hero Select only; the match then ends in the lobby.
REVIVE_EXPERIMENTAL_HOSTING=1
